# ── API ───────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000   # URL ของ FastAPI backend

# ── Mode ──────────────────────────────────────────────────────────────────────
VITE_DRAFT_MODE=true                      # true = แสดง draft login / false = MS login เท่านั้น

# ── Microsoft Entra ID (ต้องตั้งค่าก่อนใช้งาน production) ────────────────────
# คัดลอกจาก Azure Portal → Entra ID → App registrations → [app] → Overview
VITE_AZURE_CLIENT_ID=                     # Application (client) ID
VITE_AZURE_TENANT_ID=                     # Directory (tenant) ID
