# ── Template — คัดลอกไฟล์นี้เป็น .env.development / .env.staging / .env.production
# แล้วใส่ค่าจริงก่อนรัน (ไฟล์นี้ commit เข้า repo ได้ — ไม่มี secret)

# URL ของ FastAPI backend
VITE_API_BASE_URL=

# true = แสดง draft login (ใช้ dev เท่านั้น) / false = MS login เท่านั้น
VITE_DRAFT_MODE=

# Microsoft Entra ID — คัดลอกจาก Azure Portal → Entra ID → App registrations
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=

# ชื่อแอปที่แสดงใน title bar (optional — มี default ใน .env)
VITE_APP_TITLE=
