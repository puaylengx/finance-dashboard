# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Seamless Dashboard API"
APP_VERSION="1.0.0"
DEBUG=false
# รองรับ 2 รูปแบบ:
# แบบ comma-separated: ALLOWED_ORIGINS=http://localhost:5173,https://example.com
# แบบ JSON array:      ALLOWED_ORIGINS=["http://localhost:5173","https://example.com"]
ALLOWED_ORIGINS=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────────
DB_MODE=direct                    # "direct" | "ssh"
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ic_finance
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=20
DB_CONNECT_TIMEOUT=10

# ── SSH Tunnel (required when DB_MODE=ssh) ───────────────────────────────────
SSH_HOST=192.168.1.100
SSH_PORT=22
SSH_USERNAME=your-ssh-user
SSH_KEY_PATH=/path/to/private_key   # use this OR SSH_PASSWORD
SSH_PASSWORD=                       # optional if key-based auth

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_DEFAULT=300       # seconds — finance dashboard cache
REDIS_TTL_MASTER=3600       # seconds — master data cache
REDIS_TTL_COORDINATOR=600   # seconds — coordinator lookup cache

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRES_SECONDS=28800
ENCRYPTION_KEY=                     # Fernet key; auto-generated if empty (ephemeral)

# ── Microsoft Entra ID ────────────────────────────────────────────────────────
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_AUTHORITY=https://login.microsoftonline.com/your-tenant-id

# ── Draft Mode ────────────────────────────────────────────────────────────────
# true  → /auth/draft-login พร้อมใช้ (สำหรับ dev/staging ที่ยังไม่เชื่อมต่อ Azure จริง)
# false → /auth/draft-login ถูกปิด (production เท่านั้นใช้ /auth/entra-login)
DRAFT_MODE=true

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=200/minute

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
SENTRY_DSN=                         # optional Sentry DSN

# ── Dev-only: local users (JSON array) ───────────────────────────────────────
# AUTH_USERS_JSON=[{"username":"admin","password_hash":"$2b$12$...","role":"fa","name":"Admin User"}]
AUTH_USERS_JSON=[]
